+		if (sum > edges[i][0] && edges[i][0] / sum < f) {
+			f = edges[i][0] / sum;
+		}
+	}
+	for (int i = 0; i < 4; i++) {
+		dst[i] = radii[i] > 0 ? radii[i] * f : 0;
+	}
